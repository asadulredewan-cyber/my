{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/scheduler/check-and-post?slot=early",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/scheduler/check-and-post?slot=afternoon",
      "schedule": "0 9 * * *"
    }
  ]
}
